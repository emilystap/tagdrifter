# Keep LF line endings in the repo and in working copies on every OS. The code runs in a
# Linux container, and LF everywhere avoids CRLF churn from Windows checkouts.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary test fixtures
*.flac binary
*.mp3 binary
*.m4a binary
*.jpg binary
*.png binary
